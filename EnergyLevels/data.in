# Energies, widths and uncertainties: MeV. Full-line # comments only.
# Quote level labels containing spaces. Scalar settings need no quotes.
[figure]
# Output stem (no extension); paths are relative to the working directory.
output = GSM_39Ca_40CaLambda
# PDF is convenient; PGF requires xelatex. Override with --format.
format = pdf
# Pixels per inch. Physical size = size_px / dpi.
dpi = 350.0
# Nominal width,height in pixels.
size_px = 1200.0, 900.0
# Minor,major spacing on the energy axis (MeV).
ticks = 0.02, 0.2
# Extra horizontal padding; range 0 to 1.
x_margin = 0.5
# Vertical padding factor; range 0 to 1.
y_margin = 0.03
# Padding between the energy-axis label and the axis, in points; >= 0.
ylabel_pad = 12.0
# Level-line length as a fraction of the column pitch (center-to-center
# distance between columns, auto-sized from the energy range); 0 < value < 1.
# The rest of the pitch is the gap between columns. Default 0.7 (70% line,
# 30% gap). This is the setting that visibly changes the line length.
column_width = 0.7
# Draw a thin black connector from a level line to its side spin-parity
# label; yes/no. Per-state label_line=yes/no overrides this default.
label_line = no
# Break the energy axis inside the given displayed-energy gaps, with // marks;
# none disables it. Give pairs low1, high1, low2, high2, ... for one or more
# breaks (values must strictly increase; no state may lie strictly inside a
# gap). Each break adds one stacked panel sharing the x axis.
axis_break = 0.3,2.3, 3.3,5.9
# White gap between the two panels of an axis break, as a fraction of the
# average panel height; 0 to 1. Only used when axis_break is set.
break_gap = 0.04
# Width-box opacity; 0 transparent, 1 opaque.
width_alpha = 0.4
# Inset on each side of a width box; 0 <= value < 0.5.
width_spacing = 0.1
# Size of the error-bar end caps, as a multiple of the level-line length;
# >= 0, 0 draws a plain line without caps. Default 10 (previous behavior).
errorbar_head = 3.0
# Displayed energy = input energy - reference_energy.
reference_energy = 0.0
# Energy-axis label.
ylabel = $\mathrm{E_x}$ (MeV)
# Level labels and tick labels, in points.
font_size = 10.0
# Dataset titles and axis label, in points.
title_size = 11.0
# Color of the bottom and top level texts (the labels under/over each level
# line): black (default) or level (same color as that level's line).
# text_color = black

[dataset 1]
name = Exp-$^{39}$Ca-
# name_pos = auto (default) keeps the name as the x tick label centered under
# the column. Give two comma-separated figure coordinates to draw the name as a
# text at that (x, y) position instead, e.g. name_pos = 0.2, 0.8
# name_pos = auto
color = -1
linestyle = -

[levels 1]
# id energy width uncertainty j parity label_index jpi bottom top [options]
0  0.0  -1.0  -1.0  3/2  1  -1  left  None  None
1  2.467  -1.0  0.1  1/2  1  -1  left  None  None
2  2.796  0.1  -1.0  7/2  0  -1  left  None  None
3  3.025  -1.0  -1.0  3/2  0  -1  left  None  None

[dataset 2]
name = GSM
color = 0
linestyle = -

[levels 2]
# id energy width uncertainty j parity label_index jpi bottom top [options]
4  0.0  -1.0  -1.0  3/2  1  -1  None  None  None  link=0  link_color=-1  link_style=--
5  2.483  -1.0  -1.0  1/2  1  -1  None  None  None  color=1  link=1  link_color=-1  link_style=--
6  2.701  -1.0  -1.0  7/2  0  -1  None  None  None  color=2  link=2  link_color=-1  link_style=--
7  3.03  -1.0  -1.0  3/2  0  -1  None  None  None  color=3  link=3  link_color=-1  link_style=--

[dataset 3]
name = $^{40}_\Lambda\mathrm{Ca}$
color = 0
linestyle = -

# label_dy shifts ONLY the spin label (MeV), for close doublets.
# label_dx shifts ONLY the spin label horizontally (x data units)
# label_line=yes draws a black connector from the level line to the label.
[levels 3]
# id energy width uncertainty j parity label_index jpi bottom top [options]
# options: color, linestyle, link, link_color, link_style, link_width, label_dy, label_line
8  0.0  -1.0  -1.0  1  1  1  right  None  None  link=4  link_color=0  link_style=--  link_width=0.5  label_dy=-0.045 label_dx=0.2  label_line=yes
9  0.029  -1.0  -1.0  2  1  1  right  None  None  link=4  link_color=0  link_style=--  link_width=0.5  label_dy=0.035  label_line=yes
